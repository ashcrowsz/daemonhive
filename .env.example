# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Models: LiteLLM aliases (see deploy/litellm*.yaml)
LITELLM_CONFIG=litellm.local.yaml
HIVE_MODEL_SMALL=hive-small
HIVE_MODEL_LARGE=hive-large
# "none" skips thinking tokens on local reasoning models (gemma 4 / qwen 3)
HIVE_REASONING_EFFORT=none

# Memory: cypher = structured facts straight into Neo4j, no LLM ($0). graphiti = LLM extraction.
MEMORY_BACKEND=cypher
NEO4J_USER=neo4j
NEO4J_PASSWORD=hivehive

# Well-being
KCAL_TARGET=2800

# Per-agent LiteLLM keys (any value works with the local config; real budgets need the key DB)
LITELLM_KEY_CONCIERGE=sk-concierge
LITELLM_KEY_FITNESS=sk-fitness
LITELLM_KEY_WELLBEING=sk-wellbeing
LITELLM_KEY_WORK=sk-work
LITELLM_KEY_SCRIBE=sk-scribe

# Local URLs when running an agent outside compose (compose overrides these)
DATABASE_URL=postgresql://hive:hive@localhost:5432/hive
NATS_URL=nats://localhost:4222
NEO4J_URI=bolt://localhost:7687
LITELLM_BASE_URL=http://localhost:4000
FITNESS_URL=http://localhost:8101
WELLBEING_URL=http://localhost:8102
WORK_URL=http://localhost:8103
