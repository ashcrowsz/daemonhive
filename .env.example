# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Models: LiteLLM aliases (see deploy/litellm*.yaml)
LITELLM_CONFIG=litellm.local.yaml
HIVE_MODEL_SMALL=hive-small
HIVE_MODEL_LARGE=hive-large
# "none" skips thinking tokens on local reasoning models (gemma 4 / qwen 3)
HIVE_REASONING_EFFORT=none

# Memory: cypher = structured facts straight into Neo4j, no LLM ($0). graphiti = LLM extraction.
MEMORY_BACKEND=cypher
NEO4J_USER=neo4j
NEO4J_PASSWORD=hivehive

# Well-being: daily calorie target. A day 500+ kcal under it (or a 3-day average 400+ under)
# flags CalorieDeficit; a night under 5 h (or a 3-night average under 6 h) flags SleepDeficit.
KCAL_TARGET=1950

# LiteLLM refuses to start without a master key; agents use it unless they have their own key
# generate one: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=
# Per-agent virtual keys + budgets need LiteLLM's key DB (cloud setup); leave unset locally
# LITELLM_KEY_FITNESS=

# Local URLs when running an agent outside compose (compose overrides these)
DATABASE_URL=postgresql://hive:hive@localhost:5432/hive
NATS_URL=nats://localhost:4222
NEO4J_URI=bolt://localhost:7687
LITELLM_BASE_URL=http://localhost:4000
FITNESS_URL=http://localhost:8101
WELLBEING_URL=http://localhost:8102
WORK_URL=http://localhost:8103

# Where LiteLLM finds LM Studio. Docker Desktop: leave unset (host.docker.internal).
# Docker Engine in WSL: the Windows host on the WSL network (ip route | awk '/default/{print $3}')
# LMSTUDIO_API_BASE=http://<that address>:1234/v1
